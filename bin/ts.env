# Settings for technosophia's shared scripts (`ts`). Each script's --help
# says which it reads. The host is the ~/.ssh/config alias.
HOST=commons
URL=https://imitation.rvanegas.co
HEALTH_LOCAL=http://127.0.0.1:8080/healthz
DEPLOY_DEST=/home/ubuntu/imitation
DEPLOY_LOG=.local/state/imitation/deploys.log
WORKTREE_PACKAGES=". app"
