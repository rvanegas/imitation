# The imitation server on the commons box: Telegram bot and WebSocket in one
# process. Installed by bin/deploy. Config and state are the deploy user's XDG
# dirs (~/.config/imitation/config.toml, ~/.local/state/imitation); the config
# sets [websocket] host = "127.0.0.1" so only Caddy reaches the port.
[Unit]
Description=Imitation game server
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/imitation
ExecStart=/usr/bin/node dist/main.js server
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
